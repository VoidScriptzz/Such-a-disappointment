local function createButton(text, posX, isRed)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.4, 0, 0, 50)
    btn.Position = UDim2.new(posX, 0, 0.5, -25)
    btn.BackgroundColor3 = isRed and Color3.fromRGB(200, 50, 50) or Color3.fromRGB(0, 140, 255)
    btn.Text = text
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 16
    btn.TextColor3 = Color3.fromRGB(255,255,255)
    btn.BorderSizePixel = 0
    btn.Parent = main

    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 10)

    local s = Instance.new("UIStroke", btn)
    s.Color = isRed and Color3.fromRGB(255,100,100) or Color3.fromRGB(0,200,255)

    btn.MouseEnter:Connect(function()
        if isRed then
            btn.BackgroundColor3 = Color3.fromRGB(220, 70, 70)
            s.Color = Color3.fromRGB(255,140,140)
        else
            btn.BackgroundColor3 = Color3.fromRGB(0,170,255)
            s.Color = Color3.fromRGB(120,220,255)
        end
    end)

    btn.MouseLeave:Connect(function()
        if isRed then
            btn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
            s.Color = Color3.fromRGB(255,100,100)
        else
            btn.BackgroundColor3 = Color3.fromRGB(0,140,255)
            s.Color = Color3.fromRGB(0,200,255)
        end
    end)

    return btn
end

