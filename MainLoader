local function createButton(text, posX, isRed)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.4, 0, 0, 65)
    btn.Position = UDim2.new(posX, 0, 0.55, -30)
    btn.BackgroundColor3 = isRed and Color3.fromRGB(170, 40, 40) or Color3.fromRGB(0, 120, 255)
    btn.Text = text
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 17
    btn.TextColor3 = Color3.fromRGB(255,255,255)
    btn.BorderSizePixel = 0
    btn.Parent = main

    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 12)

    local s = Instance.new("UIStroke", btn)
    s.Color = isRed and Color3.fromRGB(255,90,90) or Color3.fromRGB(0,200,255)
    s.Thickness = 1.2

    btn.MouseEnter:Connect(function()
        if isRed then
            btn.BackgroundColor3 = Color3.fromRGB(200, 60, 60)
            s.Color = Color3.fromRGB(255,130,130)
        else
            btn.BackgroundColor3 = Color3.fromRGB(0,150,255)
            s.Color = Color3.fromRGB(120,220,255)
        end
    end)

    btn.MouseLeave:Connect(function()
        if isRed then
            btn.BackgroundColor3 = Color3.fromRGB(170, 40, 40)
            s.Color = Color3.fromRGB(255,90,90)
        else
            btn.BackgroundColor3 = Color3.fromRGB(0,120,255)
            s.Color = Color3.fromRGB(0,200,255)
        end
    end)

    return btn
end

